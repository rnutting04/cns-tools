# Local object storage (SeaweedFS) allows anonymous access, so these are
# only here to satisfy the backend's required SPACES_* settings. Any
# non-empty values work locally.
S3_ACCESS_KEY=local_access_key
S3_SECRET_KEY=local_secret_key
DATABASE_URL=postgresql://cs_user:localpassword@localhost:5432/cs_tool_hub
ANTHROPIC_API_KEY=sk-ant-
SECRET_KEY=dev_secret_key_change_me

SPACES_ENDPOINT=http://localhost:9000
SPACES_KEY=local_access_key
SPACES_SECRET=local_secret_key
SPACES_BUCKET=cs-tool-hub

SEED_ADMIN_PASSWORD=superadmin123
SEED_MANAGER_PASSWORD=manager123

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

RESEND_API_KEY=re

# Deployment environment: local | staging | production.
# Only "production" delivers email to real recipients; local/staging redirect
# all mail to LOCAL_EMAIL_TO. Defaults to "local" if unset.
ENVIRONMENT=local
# Catch-all inbox for redirected mail in non-production environments.
LOCAL_EMAIL_TO=you@example.com
# Address recipients reply to (any domain; need not be verified in Resend).
EMAIL_REPLY_TO=
# Public URL of the site. Used for links and the logo image in emails, so it
# must be on the same domain as EMAIL_FROM for deliverability.
FRONTEND_URL=http://localhost:5173
# Sender address. The domain must be verified in Resend.
EMAIL_FROM=C&S Dev Services <notifications@mail.cscmsi.net>

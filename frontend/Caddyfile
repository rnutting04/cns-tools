:80 {
    handle_path /api/* {
        reverse_proxy http://{$BACKEND_URL} {
            header_up Host {$BACKEND_URL}
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
        format console
    }
}